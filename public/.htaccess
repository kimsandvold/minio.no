# SPA fallback: serve index.html for any path that isn't an existing file/dir
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Skip if request maps to an existing file or directory
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Otherwise rewrite to index.html so React Router can handle the route
  RewriteRule . /index.html [L]
</IfModule>

# Cache hashed assets aggressively, never cache the HTML entry
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|webp|png|jpg|jpeg|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
