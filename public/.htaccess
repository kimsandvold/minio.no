# SPA fallback: serve index.html for any path that isn't an existing file/dir
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Mappa med Leah Noelles spill har ingen index.html (ville gitt 403) –
  # send besøkende til spillsiden hennes i stedet.
  RewriteRule ^leah-noelle/?$ /spill-av-leah-noelle [R=301,L]

  # Samme for byggeguider/prosjekter/ (har bare undersider, ingen index.html).
  RewriteRule ^byggeguider/prosjekter/?$ /byggeguider [R=301,L]

  # Gamle adresser (React-ruta <Navigate> gjør det samme, men da får søkemotorer
  # 200 på en tom side – og en gammel prerendret mappe på serveren ville vunnet).
  RewriteRule ^skilt-og-gravering/?$ /gravering [R=301,L]
  RewriteRule ^diy-guider/?$ /byggeguider [R=301,L]
  RewriteRule ^(terrasse|pergola|carport)planlegger/?$ /planleggere/$1 [R=301,L]

  # Skip if request maps to an existing file, or a directory with its own
  # index.html (prerendered routes). Directories WITHOUT index.html (images/,
  # fonts/, assets/ …) fall through to the SPA so they show the 404 page
  # instead of Apache's 403.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]

  # Otherwise rewrite to index.html so React Router can handle the route
  RewriteRule . /index.html [L]
</IfModule>

# ── Komprimering ────────────────────────────────────────────────────────────
# Tekstressurser (HTML, JS, CSS, JSON, SVG, XML) komprimeres i farta. Brotli der
# serveren har mod_brotli, ellers gzip via mod_deflate. Bilder/woff2 er allerede
# komprimert og hoppes over. IfModule gjør at ingenting brekker om modulen mangler.
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml text/javascript application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>
<IfModule !mod_brotli.c>
  <IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml text/javascript application/javascript application/json application/xml application/manifest+json image/svg+xml
  </IfModule>
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|json|svg|xml|txt)$">
    Header append Vary Accept-Encoding
  </FilesMatch>
</IfModule>

# ── Caching ─────────────────────────────────────────────────────────────────
# /assets/ har innholds-hash i filnavnet (Vite) → kan caches «for alltid».
# Alt annet i public/ (bilder, fonter, spill-filer) har faste navn og kan bli
# byttet ut uten nytt navn → kortere cache, ellers ser besøkende gamle bilder
# i et helt år. HTML (inkl. prerendrede ruter) revalideres ved hvert besøk:
# «no-cache» = alltid sjekk med serveren (ETag/304), men tillater back/forward-
# cache, i motsetning til no-store.
<IfModule mod_headers.c>
  <FilesMatch "\.(webp|avif|png|jpe?g|gif|svg|ico|woff2?|ttf|mp4|webm)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </FilesMatch>
  <FilesMatch "\.(js|mjs|css|json)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
