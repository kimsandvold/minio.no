rules_version = '2';

// Minio Firestore-sikkerhetsregler (speiler det som ligger i Firebase-konsollen).
// Deploy: lim inn i konsollen (Firestore Database → Rules → Publish),
// eller kjør `firebase deploy --only firestore:rules` hvis du har firebase-tools.

service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow read, update: if request.auth != null
                          && request.auth.token.email == 'kimsandvold@gmail.com';
    }

    match /designs/{designId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null
                                  && resource.data.userId == request.auth.uid;
      allow read: if request.auth != null
                  && request.auth.token.email == 'kimsandvold@gmail.com';
    }

    // Designverktøy-prosjekter.
    //
    // Betalingsfeltene (betalt, kjopt, frosset, tilgangskode, kodeForsok,
    // vipps) er SERVER-ONLY: de skrives bare av Vercel-funksjonene under
    // /api/vipps/ via Firebase Admin SDK, som går forbi disse reglene. Uten
    // dette kunne en innlogget kunde satt betalt=true fra nettleserkonsollen
    // og lastet ned byggeplanen gratis.
    match /designerProsjekter/{projectId} {
      // Nye design opprettes alltid ubetalt og uten kode.
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.betalt == false
                    && !request.resource.data.keys()
                         .hasAny(['frosset', 'tilgangskode', 'kodeForsok', 'vipps'])
                    && (!('kjopt' in request.resource.data)
                        || request.resource.data.kjopt.keys().size() == 0);

      allow read, delete: if request.auth != null
                          && resource.data.userId == request.auth.uid;

      // Kunden kan endre designet sitt (navn, config, overrides), men ingen
      // av feltene som avgjør hva som er betalt – og kan ikke gi det bort.
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId
                    && !request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasAny(['betalt', 'kjopt', 'frosset', 'tilgangskode',
                                  'kodeForsok', 'vipps']);

      allow read: if request.auth != null
                  && request.auth.token.email == 'kimsandvold@gmail.com';
    }

    // Forespørsler fra designverktøyet (bygging / materialpakke / byggeplan).
    // Kunden oppretter sin egen, men får ALDRI lese noen av dem: en
    // 'byggeplan'-forespørsel bærer tilgangskoden kunden skal betale for, og
    // Firestore kan ikke skjule enkeltfelt i et lesbart dokument.
    //
    // 'byggeplan'-forespørsler opprettes bare av api/plan/bestill.ts (Admin
    // SDK, går forbi disse reglene). Klienten kan derfor verken velge sin egen
    // kode eller lage en byggeplan-forespørsel selv.
    match /designForesporsler/{id} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.type in ['ferdig', 'materialpakke']
                    && !request.resource.data.keys().hasAny(['tilgangskode', 'innlostAt']);
      allow read, update: if request.auth != null
                          && request.auth.token.email == 'kimsandvold@gmail.com';
    }

    // Prosjektidéer fra /prosjekthjelp. Skjemaet er lav-terskel-inngangen til
    // nettverket og krever ingen innlogging, så create tillates uten auth –
    // men bare med nøyaktig disse feltene, med størrelsesgrenser og status
    // 'ny'. Ingen andre enn admin kan lese eller endre noe; dialogen videre
    // går på e-post.
    match /prosjektIdeer/{id} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['navn', 'epost', 'sted', 'prosjektType', 'melding', 'status', 'createdAt'])
                    && request.resource.data.navn is string
                    && request.resource.data.navn.size() > 0
                    && request.resource.data.navn.size() <= 120
                    && request.resource.data.epost is string
                    && request.resource.data.epost.size() >= 5
                    && request.resource.data.epost.size() <= 200
                    && request.resource.data.sted is string
                    && request.resource.data.sted.size() <= 120
                    && request.resource.data.prosjektType is string
                    && request.resource.data.prosjektType.size() <= 60
                    && request.resource.data.melding is string
                    && request.resource.data.melding.size() >= 10
                    && request.resource.data.melding.size() <= 4000
                    && request.resource.data.status == 'ny';
      allow read, update: if request.auth != null
                          && request.auth.token.email == 'kimsandvold@gmail.com';
    }

    match /polls/{pollId} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.auth.token.email == 'kimsandvold@gmail.com';
    }

    match /polls/{pollId}/voters/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /ads/{adId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.token.email == "kimsandvold@gmail.com";
    }
  }
}
