rules_version = '2';

// Minio Firestore-sikkerhetsregler (speiler det som ligger i Firebase-konsollen).
// Deploy: lim inn i konsollen (Firestore Database → Rules → Publish),
// eller kjør `firebase deploy --only firestore:rules` hvis du har firebase-tools.

service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * Admin.
     *
     * `email_verified` er ikke pynt her. Så lenge Google var eneste vei inn,
     * var e-postadressen i seg selv bevis nok: Google utsteder bare et token
     * for adressen til den som eier kontoen. Etter at innlogging med e-post og
     * passord ble slått på, er det ikke lenger sant – står Firebase satt til å
     * tillate flere kontoer per adresse, kan hvem som helst registrere
     * admin-adressen med sitt eget passord og få tokenet til å se riktig ut.
     *
     * Kravet om bekreftet adresse lukker det uansett hvordan den innstillingen
     * står: Google-kontoen er alltid bekreftet, en påmeldt kopi er det ikke,
     * og den som ikke eier innboksen får den aldri bekreftet.
     */
    function erAdmin() {
      return request.auth != null
             && request.auth.token.email == 'kimsandvold@gmail.com'
             && request.auth.token.email_verified == true;
    }

    match /orders/{orderId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow read, update: if erAdmin();
    }

    match /designs/{designId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null
                                  && resource.data.userId == request.auth.uid;
      allow read: if erAdmin();
    }

    // Designverktøy-prosjekter.
    //
    // Betalingsfeltene (betalt, kjopt, frosset, tilgangskode, kodeForsok,
    // vipps) er SERVER-ONLY: de skrives bare av Vercel-funksjonene under
    // /api/vipps/ via Firebase Admin SDK, som går forbi disse reglene. Uten
    // dette kunne en innlogget kunde satt betalt=true fra nettleserkonsollen
    // og lastet ned byggeplanen gratis.
    match /designerProsjekter/{projectId} {
      // Nye design opprettes alltid ubetalt og uten kode.
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.betalt == false
                    && !request.resource.data.keys()
                         .hasAny(['frosset', 'tilgangskode', 'kodeForsok', 'vipps'])
                    && (!('kjopt' in request.resource.data)
                        || request.resource.data.kjopt.keys().size() == 0);

      allow read, delete: if request.auth != null
                          && resource.data.userId == request.auth.uid;

      // Kunden kan endre designet sitt (navn, config, overrides), men ingen
      // av feltene som avgjør hva som er betalt – og kan ikke gi det bort.
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == resource.data.userId
                    && !request.resource.data.diff(resource.data)
                         .affectedKeys()
                         .hasAny(['betalt', 'kjopt', 'frosset', 'tilgangskode',
                                  'kodeForsok', 'vipps']);

      allow read: if erAdmin();
    }

    // Forespørsler fra designverktøyet (bygging / materialpakke / byggeplan).
    // Kunden oppretter sin egen, men får ALDRI lese noen av dem: en
    // 'byggeplan'-forespørsel bærer tilgangskoden kunden skal betale for, og
    // Firestore kan ikke skjule enkeltfelt i et lesbart dokument.
    //
    // 'byggeplan'-forespørsler opprettes bare av api/plan/bestill.ts (Admin
    // SDK, går forbi disse reglene). Klienten kan derfor verken velge sin egen
    // kode eller lage en byggeplan-forespørsel selv.
    match /designForesporsler/{id} {
      // Nøyaktig feltene src/services/foresporselService.ts skriver – ingen
      // tilgangskode, adminVarslet eller annen status enn 'ny'.
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.type in ['ferdig', 'materialpakke']
                    && request.resource.data.keys().hasOnly(
                         ['userId', 'userEmail', 'type', 'designId', 'produktId', 'produktNavn',
                          'designNavn', 'sammendrag', 'konfigurasjon', 'config', 'overrides',
                          'maal', 'arealM2', 'estimatKr', 'prisEstimatKr', 'melding', 'status',
                          'createdAt'])
                    && request.resource.data.status == 'ny';
      allow read, update: if erAdmin();
    }

    // Prosjektidéer fra /prosjekthjelp. Skjemaet er lav-terskel-inngangen til
    // nettverket og krever ingen innlogging, så create tillates uten auth –
    // men bare med nøyaktig disse feltene, med størrelsesgrenser og status
    // 'ny'. Ingen andre enn admin kan lese eller endre noe; dialogen videre
    // går på e-post.
    match /prosjektIdeer/{id} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['navn', 'epost', 'sted', 'prosjektType', 'melding', 'status', 'createdAt'])
                    && request.resource.data.navn is string
                    && request.resource.data.navn.size() > 0
                    && request.resource.data.navn.size() <= 120
                    && request.resource.data.epost is string
                    && request.resource.data.epost.size() >= 5
                    && request.resource.data.epost.size() <= 200
                    && request.resource.data.sted is string
                    && request.resource.data.sted.size() <= 120
                    && request.resource.data.prosjektType is string
                    && request.resource.data.prosjektType.size() <= 60
                    && request.resource.data.melding is string
                    && request.resource.data.melding.size() >= 10
                    && request.resource.data.melding.size() <= 4000
                    && request.resource.data.status == 'ny';
      allow read, update: if erAdmin();
    }

    // Henvendelser fra kontaktskjemaet og «eget emne». Disse gikk tidligere
    // BARE på e-post via Formspree, og forsvant hvis e-posten druknet. De
    // lagres nå i tillegg her, slik at alt kunden sender finnes igjen under
    // /admin/henvendelser. Som prosjektidéene: ingen innlogging kreves, men
    // feltene er låst og bare admin kan lese.
    match /henvendelser/{id} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['kilde', 'emne', 'navn', 'epost', 'mobil', 'melding', 'detaljer', 'status', 'createdAt'])
                    && request.resource.data.kilde in ['kontakt', 'eget-emne']
                    && request.resource.data.emne is string
                    && request.resource.data.emne.size() <= 160
                    && request.resource.data.navn is string
                    && request.resource.data.navn.size() > 0
                    && request.resource.data.navn.size() <= 120
                    && request.resource.data.epost is string
                    && request.resource.data.epost.size() >= 5
                    && request.resource.data.epost.size() <= 200
                    && request.resource.data.mobil is string
                    && request.resource.data.mobil.size() <= 40
                    && request.resource.data.melding is string
                    && request.resource.data.melding.size() <= 4000
                    && (!request.resource.data.keys().hasAny(['detaljer'])
                        || request.resource.data.detaljer.size() <= 12)
                    && request.resource.data.status == 'ny';
      allow read, update: if erAdmin();
    }

    // Graveringsbestillinger fra /gravering. Som prosjektidéene krever de
    // ingen innlogging – en gravert gave skal ikke kreve Google-pålogging –
    // så create er åpen, men bundet til nøyaktig disse feltene med grenser.
    // `svg` er produksjonsfila med teksten som kurver, og kan derfor bli stor;
    // 400 kB er romslig for et motiv og godt under Firestores feltgrense.
    // Bare admin kan lese: dokumentet bærer kundens navn, e-post og telefon.
    match /graveringBestillinger/{id} {
      allow create: if request.resource.data.keys().hasOnly(
                         ['navn', 'epost', 'telefon', 'adresse', 'postnr', 'sted', 'melding',
                          'produktId', 'produktNavn', 'sammendrag', 'maal', 'prisSum', 'valg',
                          'svg', 'filnavn', 'ordreId', 'antall', 'status', 'createdAt'])
                    && request.resource.data.navn is string
                    && request.resource.data.navn.size() > 0
                    && request.resource.data.navn.size() <= 120
                    && request.resource.data.epost is string
                    && request.resource.data.epost.size() >= 5
                    && request.resource.data.epost.size() <= 200
                    && request.resource.data.telefon is string
                    && request.resource.data.telefon.size() <= 40
                    && request.resource.data.adresse is string
                    && request.resource.data.adresse.size() > 0
                    && request.resource.data.adresse.size() <= 200
                    && request.resource.data.postnr is string
                    && request.resource.data.postnr.size() == 4
                    && request.resource.data.sted is string
                    && request.resource.data.sted.size() > 0
                    && request.resource.data.sted.size() <= 120
                    && request.resource.data.melding is string
                    && request.resource.data.melding.size() <= 4000
                    && request.resource.data.produktId is string
                    && request.resource.data.produktId.size() <= 40
                    && request.resource.data.produktNavn is string
                    && request.resource.data.produktNavn.size() <= 80
                    && request.resource.data.sammendrag is string
                    && request.resource.data.sammendrag.size() <= 4000
                    && request.resource.data.maal is string
                    && request.resource.data.maal.size() <= 40
                    && request.resource.data.prisSum is number
                    && request.resource.data.prisSum >= 0
                    && request.resource.data.prisSum <= 100000
                    && request.resource.data.valg is map
                    && request.resource.data.svg is string
                    && request.resource.data.svg.size() <= 400000
                    && request.resource.data.filnavn is string
                    && request.resource.data.filnavn.size() <= 160
                    && request.resource.data.ordreId is string
                    && request.resource.data.ordreId.size() > 0
                    && request.resource.data.ordreId.size() <= 40
                    && request.resource.data.antall is int
                    && request.resource.data.antall >= 1
                    && request.resource.data.antall <= 100
                    && request.resource.data.status == 'ny';
      allow read, update: if erAdmin();
    }

    // Toppliste for Terrassemester (/underholdning/tool-terrasse.html).
    // Åpen lesing; anonyme spillere kan bare opprette – med nøyaktig disse
    // feltene, validerte typer/grenser og servertidsstempel. Ingen kan endre
    // eller slette (moderering gjøres i konsollen).
    match /terrasseScores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
                         ['navn', 'poeng', 'modus', 'dag', 'linjer', 'opprettet'])
                    && request.resource.data.keys().hasAll(
                         ['navn', 'poeng', 'modus', 'dag', 'linjer', 'opprettet'])
                    && request.resource.data.navn is string
                    && request.resource.data.navn.size() >= 2
                    && request.resource.data.navn.size() <= 16
                    && !request.resource.data.navn.matches('.*[<>/\\\\@:].*')
                    && request.resource.data.poeng is int
                    && request.resource.data.poeng >= 0
                    && request.resource.data.poeng <= 1000000
                    && request.resource.data.modus in ['dopause', 'uendelig', 'daglig']
                    && request.resource.data.dag is string
                    && request.resource.data.dag.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.linjer is int
                    && request.resource.data.linjer >= 0
                    && request.resource.data.linjer <= 100000
                    && request.resource.data.opprettet == request.time;
      allow update, delete: if false;
    }

    // Toppliste for Dreiemester (/underholdning/tool-dreiemester.html). Samme
    // modell som Terrassemester: åpen lesing, kun oppretting med validerte felt.
    match /dreiemesterScores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
                         ['navn', 'poeng', 'modus', 'dag', 'emner', 'opprettet'])
                    && request.resource.data.keys().hasAll(
                         ['navn', 'poeng', 'modus', 'dag', 'emner', 'opprettet'])
                    && request.resource.data.navn is string
                    && request.resource.data.navn.size() >= 2
                    && request.resource.data.navn.size() <= 16
                    && !request.resource.data.navn.matches('.*[<>/\\\\@:].*')
                    && request.resource.data.poeng is int
                    && request.resource.data.poeng >= 0
                    && request.resource.data.poeng <= 1000000
                    && request.resource.data.modus in ['akkord', 'daglig']
                    && request.resource.data.dag is string
                    && request.resource.data.dag.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.emner is int
                    && request.resource.data.emner >= 0
                    && request.resource.data.emner <= 1000
                    && request.resource.data.opprettet == request.time;
      allow update, delete: if false;
    }

    // Toppliste for Vedhoggeren (/underholdning/tool-ved.html). Samme modell
    // som de andre spillene: åpen lesing, kun oppretting med validerte felt.
    match /vedhoggerScores/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(
                         ['navn', 'poeng', 'modus', 'dag', 'kubber', 'opprettet'])
                    && request.resource.data.keys().hasAll(
                         ['navn', 'poeng', 'modus', 'dag', 'kubber', 'opprettet'])
                    && request.resource.data.navn is string
                    && request.resource.data.navn.size() >= 2
                    && request.resource.data.navn.size() <= 16
                    && !request.resource.data.navn.matches('.*[<>/\\\\@:].*')
                    && request.resource.data.poeng is int
                    && request.resource.data.poeng >= 0
                    && request.resource.data.poeng <= 1000000
                    && request.resource.data.modus in ['akkord', 'daglig']
                    && request.resource.data.dag is string
                    && request.resource.data.dag.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && request.resource.data.kubber is int
                    && request.resource.data.kubber >= 0
                    && request.resource.data.kubber <= 1000
                    && request.resource.data.opprettet == request.time;
      allow update, delete: if false;
    }

    /**
     * Kontaktlista – Minios egen e-postliste.
     *
     * Adressene ble tidligere samlet inne i Brevo, via et skjema i en iframe.
     * Nå er dette kilden, og Brevo får lista som CSV-eksport fra admin.
     *
     * Dokument-id-en er selve sikkerhetsmekanismen, og er to slag:
     *
     *   uid       – en innlogget konto eier sin egen rad. Den kan bare skrive
     *               på sin egen uid, og bare med sin egen adresse fra tokenet.
     *               Uten det siste kunne hvem som helst med en konto fylt
     *               lista med adresser de ikke eier.
     *
     *   adressen  – anonyme nyhetsbrev-påmeldinger. De kan bare OPPRETTES,
     *               aldri endres: `allow create` treffer ikke et dokument som
     *               finnes fra før, så en påmelding på en adresse som alt står
     *               der blir avvist i stedet for å overskrive den. Det er
     *               derfor en uinnlogget ikke kan melde noen andre AV, og
     *               heller ikke endre navnet på en rad som alt er der.
     *
     * Ingen andre enn admin kan lese. Raden bærer e-postadresse, navn og
     * samtykkehistorikk.
     */
    match /kontakter/{kontaktId} {
      function kontaktFelt() {
        return request.resource.data.keys().hasOnly(
                 ['uid', 'epost', 'navn', 'kilde', 'metode', 'nyhetsbrev',
                  'nyhetsbrevKilde', 'nyhetsbrevDato', 'avmeldtDato',
                  'epostVerifisert', 'opprettet', 'sistSett', 'antallOkter'])
               && request.resource.data.epost is string
               && request.resource.data.epost.size() >= 5
               && request.resource.data.epost.size() <= 200
               && request.resource.data.epost == request.resource.data.epost.lower()
               && request.resource.data.navn is string
               && request.resource.data.navn.size() <= 120
               && request.resource.data.kilde in ['innlogging', 'nyhetsbrev', 'kassen']
               && request.resource.data.metode in ['google', 'epost', 'gjenopptatt', 'ukjent']
               && request.resource.data.nyhetsbrev is bool
               && request.resource.data.antallOkter is int
               && request.resource.data.antallOkter >= 0;
      }

      // Innlogget konto: raden ligger på uid-en, og adressen MÅ være den
      // tokenet sier. `create` og `update` har samme krav, fordi tjenesten
      // skriver hele raden første gang og oppdaterer den siden.
      allow create, update: if request.auth != null
                            && kontaktId == request.auth.uid
                            && kontaktFelt()
                            && request.resource.data.uid == request.auth.uid
                            && request.resource.data.epost == request.auth.token.email.lower();

      // Anonym påmelding: raden ligger på adressen, har ingen uid, og er per
      // definisjon et samtykke – en uinnlogget har ingen annen grunn til å
      // legge seg inn her.
      allow create: if request.auth == null
                    && kontaktFelt()
                    && kontaktId == request.resource.data.epost
                    && request.resource.data.uid == ''
                    && request.resource.data.nyhetsbrev == true
                    && request.resource.data.kilde == 'nyhetsbrev'
                    && request.resource.data.antallOkter == 0;

      allow read, update, delete: if erAdmin();
    }

    /**
     * Én rad per innlogget nettleserøkt. Grunnlaget for aktivitetsgrafene
     * under /admin/kontakter.
     *
     * Kun oppretting, aldri endring eller sletting: en logg man kan skrive om
     * i etterkant er ikke en logg. `tidspunkt == request.time` tvinger
     * servertidsstempel, så ingen kan datere en økt til i fjor – samme grep
     * som topplistene til spillene bruker.
     *
     * Adressen må komme fra tokenet. Klienten kan altså telle sine egne
     * økter, men ikke skrive noen andre inn i statistikken.
     */
    match /innlogginger/{id} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['uid', 'epost', 'metode', 'tidspunkt'])
                    && request.resource.data.keys().hasAll(['uid', 'epost', 'metode', 'tidspunkt'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.epost is string
                    && request.resource.data.epost == request.auth.token.email.lower()
                    && request.resource.data.metode in ['google', 'epost', 'gjenopptatt', 'ukjent']
                    && request.resource.data.tidspunkt == request.time;
      allow read: if erAdmin();
      allow update, delete: if false;
    }

    match /polls/{pollId} {
      allow read: if true;
      allow write: if erAdmin();
    }

    match /polls/{pollId}/voters/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /ads/{adId} {
      allow read: if true;
      allow create, update, delete: if erAdmin();
    }
  }
}
