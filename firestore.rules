rules_version = '2';

// Minio Firestore-sikkerhetsregler (speiler det som ligger i Firebase-konsollen).
// Deploy: lim inn i konsollen (Firestore Database → Rules → Publish),
// eller kjør `firebase deploy --only firestore:rules` hvis du har firebase-tools.

service cloud.firestore {
  match /databases/{database}/documents {
    match /orders/{orderId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null
                  && resource.data.userId == request.auth.uid;
      allow read, update: if request.auth != null
                          && request.auth.token.email == 'kimsandvold@gmail.com';
    }

    match /designs/{designId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null
                                  && resource.data.userId == request.auth.uid;
      allow read: if request.auth != null
                  && request.auth.token.email == 'kimsandvold@gmail.com';
    }

    // Designverktøy-prosjekter (samme mønster som designs).
    match /designerProsjekter/{projectId} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if request.auth != null
                                  && resource.data.userId == request.auth.uid;
      allow read: if request.auth != null
                  && request.auth.token.email == 'kimsandvold@gmail.com';
    }

    // Forespørsler fra designverktøyet (bygging / materialpakke).
    // Kunden oppretter sin egen; kun admin kan lese og oppdatere status.
    match /designForesporsler/{id} {
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;
      allow read, update: if request.auth != null
                          && request.auth.token.email == 'kimsandvold@gmail.com';
    }

    match /polls/{pollId} {
      allow read: if true;
      allow write: if request.auth != null
                    && request.auth.token.email == 'kimsandvold@gmail.com';
    }

    match /polls/{pollId}/voters/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /ads/{adId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.token.email == "kimsandvold@gmail.com";
    }
  }
}
