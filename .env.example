# ─────────────────────────────────────────────────────────────────────────
# FRONTEND (VITE_*) – bakes inn i klient-bundelen og er OFFENTLIG.
# Legg ALDRI hemmeligheter her. Firebase web-config er trygg å eksponere.
# ─────────────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_ADMIN_EMAIL=
# Valgfritt: sett kun hvis Vipps-API-et kjøres på et ANNET domene enn nettsiden.
# Tomt/utelatt = samme origin (/api/...). Eks: https://api.minio.no
VITE_VIPPS_API_URL=
# Midlertidig lanseringsmodus. Sett til 1 fram til Vipps har godkjent
# salgsavtalen og produksjonsnøklene virker. Da:
#  - byggeplanen låses opp med 6-sifret kode, ikke med Vipps i appen
#  - «Betal med Vipps» blir «Be om byggeplan» (admin varsles, sender koden)
VITE_LANSERINGSMODUS=1
# Salg av byggesøknad-heftet. Tomt/0 = heftet er tatt av salg («Kommer snart»),
# uavhengig av lanseringsmodus. Sett til 1 – sammen med SOKNAD_SALG=1 på
# serveren – når heftet skal selges igjen.
VITE_SOKNAD_SALG=
# Vipps-nummeret kunden skal betale til manuelt. Fylles inn i den ferdige
# svar-e-posten på /admin/foresporsler. Tomt = teksten sier bare «betal med Vipps».
VITE_VIPPS_NUMMER=

# Testkode som låser opp alle leveranser i designverktøyet uten betaling.
# Sett den KUN lokalt / i test-deploys. La den stå TOM (eller fjern variabelen)
# i produksjon – da er demo-opplåsingen død kode. Eks: 198000
VITE_DESIGNER_DEMO_CODE=

# ─────────────────────────────────────────────────────────────────────────
# SERVER (Vercel-funksjonene i /api) – HEMMELIG. Settes som Environment
# Variables i Vercel-dashbordet, og her lokalt for `vercel dev`.
# Denne fila (.env) er gitignorert. IKKE commit ekte nøkler.
# ─────────────────────────────────────────────────────────────────────────
# Vipps-nøkler fra portal.vippsmobilepay.com. Bruk «Test»-fanen nå, bytt til
# «Production»-verdiene etter at Vipps har godkjent salgsavtalen.
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MSN=
# 'test' (apitest.vipps.no) eller 'production' (api.vipps.no).
VIPPS_ENV=test

# Firebase-tjenestekonto for server-tilgang til Firestore. Hele JSON-en som
# ÉN linje (Firebase Console → Prosjektinnstillinger → Tjenestekontoer →
# Generer ny privat nøkkel). Firestore er gratis på Spark – ingen Blaze.
FIREBASE_SERVICE_ACCOUNT=

# Serversiden av VITE_SOKNAD_SALG. Tomt/0 = /api/vipps/create avviser kjøp av
# byggesøknad-heftet (og pakken som inneholder det). Hold de to i takt.
SOKNAD_SALG=

# Valgfritt: tillatt CORS-origin for API-et. Default https://minio.no
ALLOWED_ORIGIN=https://minio.no

# Brukes i lenken i kvitterings-e-posten. Default https://minio.no
SITE_URL=https://minio.no

# ─────────────────────────────────────────────────────────────────────────
# E-POST (Resend) – sender tilgangskoden til kunden etter betaling.
# Nøkkel fra resend.com → API Keys. Domenet i EPOST_FRA må være verifisert
# i Resend (DNS: SPF + DKIM) før det virker i produksjon.
# Mangler disse, hoppes utsendingen over – betalingen går uansett gjennom.
# ─────────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
EPOST_FRA=Minio <post@minio.no>
# Hvor varsel om nye byggeplan-forespørsler sendes (med tilgangskoden).
ADMIN_EPOST=
